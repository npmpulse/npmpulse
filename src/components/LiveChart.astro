import type { ChartPoint, ScaleKind } from '../lib/svg-chart.ts'
import ChartFigure from './ChartFigure.astro'
import SnapshotChart from './SnapshotChart.tsx'

interface Props {
  /**
   * One entry per package: the monthly record for the static drawing and the
   * range, and the recent daily window the interactive chart can drop to.
   */
  series: Array<{ name: string; monthly: ChartPoint[]; daily: ChartPoint[] }>
  /** The day the snapshot ends on -- what the interactive range presets anchor to. */
  asOf: string
  title: string
  caption: string
  unit?: string
  scale?: ScaleKind
}

const {
  series,
  asOf,
  title,
  caption,
  unit = 'downloads',
  scale = 'linear',
} = Astro.props

/** The static SVG draws the monthly record, the same view the island opens on. */
const staticSeries = series.map(({ name, monthly }) => ({
  name,
  points: monthly,
}))
---

{/*
  Two charts, one on top of the other, and only ever one of them showing.

  The one built with the page is inline SVG: it is what a crawler reads, what a
  reader without JavaScript keeps, and what is on screen from the first paint.
  The interactive one is an island that loads when it scrolls into view and, once
  mounted, tells the document so — at which point the stylesheet hides the static
  one. Nobody sees both, and nobody sees neither: the swap can only happen after
  the live chart has rendered.

  The island is `client:idle`, not `client:visible`. It was `client:visible` first,
  which never fired: the directive waits for an IntersectionObserver, the live
  chart's own container is hidden until the island says it has mounted, and a
  `display: none` element never intersects — so the island waited for a signal
  that only it could send. `idle` has no such dependency and still keeps the
  bundle off the critical path.
*/}
<div class="chart-block">
  <div class="static-chart">
    <ChartFigure
      series={staticSeries}
      granularity="monthly"
      title={title}
      unit={unit}
      scale={scale}
    />
  </div>
  <div class="live-chart">
    <SnapshotChart client:idle series={series} asOf={asOf} initialScale={scale} />
  </div>
  <p class="chart-caption">{caption}</p>
</div>

<style>
  .chart-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .live-chart {
    display: none;
  }

  .chart-caption {
    margin: 0;
    font-size: var(--type-small);
    color: var(--page-muted);
  }

  /* Set by the island's first effect, so this cannot hide the static chart before
     the live one exists. */
  :global(html[data-live-chart='ready']) .static-chart {
    display: none;
  }

  :global(html[data-live-chart='ready']) .live-chart {
    display: block;
  }
</style>
