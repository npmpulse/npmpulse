/**
 * The site's footer.
 *
 * Shared by the generated pages and the home page, so a page family is added to
 * the navigation in one place -- and so the home page, which is the page with
 * links pointing at it, carries the same way through to everything else.
 */
---

<footer class="foot">
  {/*
    The separator is the explicit string `' · '`, not `&middot;` between lines:
    Astro follows JSX whitespace rules and trims the newline after an inline
    node, so an entity on its own line was emitted glued to the next link
    ("…Figures</a> &middot;<a…") with a space only before it. The string carries
    both spaces and cannot be trimmed.
  */}
  <p>
    <a href="/">Chart any npm package</a>{' · '}
    <a href="/packages">Packages</a>{' · '}
    <a href="/compare">Compare</a>{' · '}
    <a href="/data">Figures</a>{' · '}
    <a href="/sitemap.xml">Sitemap</a>
  </p>
</footer>

<style>
  .foot {
    margin-block-start: 36px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--page-line);
    font-size: var(--type-small);
  }

  .foot p {
    margin: 0;
    max-width: none;
    font-size: inherit;
  }

  .foot a {
    color: var(--page-accent);
  }
</style>
