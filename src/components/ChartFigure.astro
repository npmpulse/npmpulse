import type { ChartSeries, ScaleKind } from '../lib/svg-chart.ts'
import { renderChart } from '../lib/svg-chart.ts'

interface Props {
  series: ChartSeries[]
  granularity: string
  title: string
  /** Omit when the caption lives outside the figure, where a caller can keep it
   *  on screen when the static chart is replaced by the interactive one. */
  caption?: string
  unit?: string
  scale?: ScaleKind
  height?: number
}

const {
  series,
  granularity,
  title,
  caption,
  unit = 'downloads',
  scale = 'linear',
  height = 360,
} = Astro.props

/*
  The same chart twice, once per theme.

  An SVG carries its own colours and CSS cannot restyle it, so the only way to
  have a chart that is legible on a light and a dark page without JavaScript is
  to draw both and let the wrapper decide. Media queries and Mantine's attribute
  are both consulted, so the reader's OS setting and an explicit choice on the
  site both work.
*/
const options = { width: 820, height, granularity, title, unit, scale }
const light = renderChart({ series }, { ...options, theme: 'light' })
const dark = renderChart({ series }, { ...options, theme: 'dark' })
---

<figure class="chart">
  <div class="on-light" aria-hidden="true" set:html={light} />
  <div class="on-dark" aria-hidden="true" set:html={dark} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .chart .on-dark {
    display: none;
  }

  .chart figcaption {
    font-size: var(--type-small);
    color: var(--page-muted);
  }

  :global(html[data-mantine-color-scheme='dark']) .chart .on-light {
    display: none;
  }
  :global(html[data-mantine-color-scheme='dark']) .chart .on-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-mantine-color-scheme='light'])) .chart .on-light {
      display: none;
    }
    :global(html:not([data-mantine-color-scheme='light'])) .chart .on-dark {
      display: block;
    }
  }
</style>
