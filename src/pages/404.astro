import Doc from '../layouts/Doc.astro'

/**
 * The page a wrong URL lands on.
 *
 * `wrangler.jsonc` sets `not_found_handling: "404-page"`, which serves
 * `/404.html` for a path the static build does not have -- but only if the
 * build produces one, and a site with no `404.astro` produces none, so every
 * mistyped URL got Cloudflare's bare default instead. Astro emits this file as
 * `dist/404.html`, and the route is deliberately absent from `siteRoutes()`, so
 * it is never listed in the sitemap.
 */
const title = 'Page not found · npmpulse'
const description =
  'That address is not one of the pages npmpulse publishes. Chart any npm package’s download history from here.'
---

<Doc title={title} description={description}>
  <h1>Page not found</h1>
  <p class="standfirst">
    There is nothing at this address. It may have been a mistyped package name,
    or a comparison the site does not publish.
  </p>
  <p>
    <a href="/">Chart any npm package</a>{' · '}
    <a href="/packages">every package we chart</a>{' · '}
    <a href="/compare">every comparison</a>.
  </p>
</Doc>
