{
  "name": "npmpulse",
  "version": "0.1.0",
  "description": "Download-history charts for npm packages, with the full record back to 2015.",
  "keywords": [
    "npm",
    "downloads",
    "charts",
    "astro",
    "cloudflare-workers"
  ],
  "homepage": "https://npmpulse.com",
  "author": "Xiao Hanyu (https://xiaohanyu.me)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:dev": "astro build && wrangler dev",
    "cf:deploy": "astro build && wrangler deploy && wrangler deploy -c wrangler.www.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check:live": "node scripts/check-live.ts",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "format:md": "prettier --write \"**/*.{md,mdx}\"",
    "og": "node scripts/render-og.ts",
    "favicons": "node scripts/render-favicons.ts",
    "data:refresh": "node scripts/refresh-data.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm license:check",
    "license:add": "node scripts/addlicense.mjs && biome format --write .",
    "license:check": "node scripts/addlicense.mjs -c",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@mantine/charts": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@plausible-analytics/tracker": "^0.4.6",
    "astro": "^7.3.8",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "addlicense-ts": "^2.0.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.125.0"
  }
}
