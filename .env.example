# Copy to `.env` and fill in to turn on Cloudflare Web Analytics.
#
# The token comes from Cloudflare's dashboard: Analytics & Logs -> Web
# Analytics -> Add a site, then copy the `token` out of the snippet it shows.
# Leave it unset and the build ships no beacon at all, so a fork does not report
# its visitors to this deployment's account. It is only emitted in a production
# build, so `astro dev` never sends anything either.
#
# PUBLIC_CF_BEACON_TOKEN=

# Copy to `.env` and set ENABLED=true to turn on Plausible Analytics from a
# self-hosted instance, as an alternative (or companion) to the beacon above.
# DOMAIN is the site as declared in that instance's settings; ENDPOINT is its
# event URL -- the default below is Plausible's cloud, so point it at your own
# instance to stay self-hosted. Leave ENABLED unset and the build ships no
# tracker at all. It is only emitted in a production build, so `astro dev`
# never sends anything either.
#
# PUBLIC_PLAUSIBLE_ENABLED=false
# PUBLIC_PLAUSIBLE_DOMAIN=npmpulse.com
# PUBLIC_PLAUSIBLE_ENDPOINT=https://plausible.io/api/event
