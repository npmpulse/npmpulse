{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "npmpulse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "routes": [{ "pattern": "npmpulse.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
